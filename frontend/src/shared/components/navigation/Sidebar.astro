---
import Icon from '@shared/components/icons/Icon.astro';
import SessionNavigation from './SessionNavigation.astro';

const {
  active = 'library',
  mode = 'pipeline',
  proteinId = undefined,
} = Astro.props;

interface NavigationItem {
  id: string;
  label: string;
  icon: string;
  iconKind: 'ui' | 'stage';
  href: string;
}

interface NavigationGroup {
  label?: string;
  items: NavigationItem[];
}

const workspaceItems: NavigationItem[] = [
  { id: 'library', label: 'Mis proteínas', icon: 'folder', iconKind: 'ui', href: '/proteins/' },
];

const pipelineItems: NavigationItem[] = proteinId ? [
  { id: 'progress', label: 'Progreso', icon: 'workflow', iconKind: 'ui', href: `/proteins/${proteinId}/progress/` },
  { id: 'info', label: 'Información', icon: 'info', iconKind: 'ui', href: `/proteins/${proteinId}/info/` },
  { id: 'comparison', label: 'Comparar análisis', icon: 'layers-3', iconKind: 'ui', href: `/proteins/${proteinId}/comparison/` },
  { id: 'topology', label: 'Topología', icon: 'membrane_topology', iconKind: 'stage', href: `/proteins/${proteinId}/topology/` },
  { id: 'bioemu', label: 'Conformeros BioEmu', icon: 'activity', iconKind: 'ui', href: `/proteins/${proteinId}/bioemu/` },
  { id: 'frustration', label: 'Frustración', icon: 'structural_frustration', iconKind: 'stage', href: `/proteins/${proteinId}/frustration/` },
  { id: 'conservation', label: 'Conservación evolutiva', icon: 'evolutionary_conservation', iconKind: 'stage', href: `/proteins/${proteinId}/conservation/` },
  { id: 'scientific-evidence', label: 'Evidencia científica', icon: 'functional_region_evidence', iconKind: 'stage', href: `/proteins/${proteinId}/scientific-evidence/` },
  { id: 'ddg', label: 'ΔΔG de variante', icon: 'variant_ddg', iconKind: 'stage', href: `/proteins/${proteinId}/variant-ddg/` },
  { id: 'arpeggio', label: 'ARPEGGIO', icon: 'structural_contacts', iconKind: 'stage', href: `/proteins/${proteinId}/arpeggio/` },
] : [];

const groups: NavigationGroup[] = mode === 'library'
  ? [{ items: workspaceItems }]
  : [
      { label: 'Espacio de trabajo', items: workspaceItems },
      { label: 'Análisis activo', items: pipelineItems },
    ];
---
<nav class="sidebar" aria-label="Navegación principal">
  <div class="brand">
    <a href="/" aria-label="Ir al inicio" title="Residue Annotation Platform">
      <span class="brand-mark"><Icon name="protein" /></span>
      <span class="brand-copy"><strong>RAP</strong><small>Residue annotation</small></span>
    </a>
  </div>

  <div class="sidebar-items">
    {groups.map((group) => group.items.length > 0 && (
      <section class="sidebar-group" aria-label={group.label}>
        {group.label && <p class="sidebar-group-label">{group.label}</p>}
        <div class="sidebar-group-items">
          {group.items.map((item) => (
            <a
              class:list={['sidebar-item', { active: active === item.id }]}
              href={item.href}
              aria-current={active === item.id ? 'page' : undefined}
              title={item.label}
              data-variant-navigation={item.id === 'ddg' ? true : undefined}
            >
              <span class="sidebar-icon-wrap"><Icon name={item.icon} kind={item.iconKind ?? 'ui'} class="sidebar-icon" /></span>
              <span>{item.label}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
  <!-- Session state exists only in the browser's sessionStorage. This component
       updates its own DOM instead of hydrating a Preact island, so route swaps
       cannot produce an SSR/client tree mismatch. -->
  <SessionNavigation active={active} />
</nav>

<style>
  .sidebar {
    position: fixed;
    z-index: 60;
    left: 14px;
    top: 14px;
    bottom: 14px;
    width: var(--nav-w);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--panel);
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .brand {
    min-height: 62px;
    display: flex;
    align-items: center;
    padding: 0 8px 8px;
    border-bottom: 1px solid var(--line);
    user-select: none;
  }
  .brand a {
    width: 100%;
    color: var(--ink);
    text-decoration: none;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
  }
  .brand-mark {
    width: 34px;
    height: 34px;
    border: 1px solid rgba(46,136,119,.38);
    border-radius: 5px;
    background: var(--green-soft);
    color: var(--green-dark);
    display: grid;
    place-items: center;
  }
  .brand-mark :global(.icon-slot) { width: 18px; height: 18px; }
  .brand-copy { min-width: 0; display: flex; flex-direction: column; gap: 1px; }
  .brand-copy strong { font-size: 12px; font-weight: 780; letter-spacing: .08em; }
  .brand-copy small { overflow: hidden; color: var(--muted); font-size: 8px; font-weight: 650; letter-spacing: .035em; white-space: nowrap; text-overflow: ellipsis; }
  .brand a:hover .brand-mark { border-color: var(--green-dark); }
  .sidebar-items { display: flex; flex-direction: column; gap: 13px; min-height: 0; overflow-y: auto; scrollbar-width: thin; padding: 4px 0; }
  .sidebar-group { display: grid; gap: 5px; }
  .sidebar-group-label { margin: 0; padding: 0 9px; color: #78838a; font-size: 8px; font-weight: 750; letter-spacing: .09em; text-transform: uppercase; }
  .sidebar-group-items { display: grid; gap: 2px; }
  .sidebar-item {
    position: relative;
    min-height: 40px;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
    color: var(--ink);
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding: 0 8px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 630;
    transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
  }
  .sidebar-item:hover { background: var(--surface); }
  .sidebar-item.active {
    background: var(--green-soft);
    border-color: rgba(46,136,119,.28);
    color: var(--green-dark);
  }
  .sidebar-item.active::before {
    content: '';
    position: absolute;
    left: -9px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    border-radius: 0 2px 2px 0;
    background: var(--green);
  }
  .sidebar-icon-wrap { width: 28px; height: 28px; display: grid; place-items: center; color: var(--muted); }
  /* PackIcon is a framework component, so Astro scoped styles cannot target its
     root element. Keep this selector global to give UI icons an explicit size. */
  .sidebar-icon-wrap :global(.sidebar-icon) { width: 17px; height: 17px; }
  .sidebar-item.active .sidebar-icon-wrap { color: var(--green-dark); }

  @media (max-width: 1100px) {
    .brand-copy small { display: none; }
    .sidebar-item { grid-template-columns: 24px minmax(0, 1fr); gap: 6px; padding-inline: 6px; font-size: 10px; }
    .sidebar-icon-wrap { width: 24px; }
  }

  @media (max-width: 760px) {
    .sidebar {
      left: 10px;
      right: 10px;
      top: 10px;
      bottom: auto;
      width: auto;
      height: 60px;
      padding: 5px;
      flex-direction: row;
      align-items: stretch;
    }
    .sidebar-items { min-width: 0; flex: 1; flex-direction: row; gap: 4px; padding: 0; overflow-x: auto; overflow-y: hidden; scrollbar-width: none; }
    .sidebar-items::-webkit-scrollbar { display: none; }
    .sidebar-group { display: block; }
    .sidebar-group + .sidebar-group { padding-left: 4px; border-left: 1px solid var(--line); }
    .sidebar-group-label { display: none; }
    .sidebar-group-items { display: flex; gap: 2px; }
    .sidebar-item { min-width: max-content; min-height: 48px; grid-template-columns: 24px minmax(0,1fr); gap: 6px; padding: 0 9px; font-size: 10px; }
    .sidebar-item.active::before { left: 9px; right: 9px; top: auto; bottom: -6px; width: auto; height: 2px; border-radius: 2px 2px 0 0; }
    .brand { flex: 0 0 auto; padding: 0 7px 0 0; min-height: 48px; border: 0; border-right: 1px solid var(--line); }
    .brand a { width: auto; grid-template-columns: 32px; gap: 0; }
    .brand-mark { width: 32px; height: 32px; }
    .brand-copy { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }

  @media (max-width: 520px) {
    .sidebar-item { grid-template-columns: 24px; padding: 0 8px; }
    .sidebar-item > span:not(.sidebar-icon-wrap) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .sidebar-item .sidebar-icon-wrap { position: static; width: 24px; height: 28px; overflow: visible; clip: auto; }
  }
</style>
