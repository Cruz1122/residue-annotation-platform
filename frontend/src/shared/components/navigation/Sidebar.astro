---
import Icon from '@shared/components/icons/Icon.astro';

const {
  active = 'library',
  mode = 'pipeline',
  proteinId = 'P01130',
} = Astro.props;

const libraryItems = [
  { id: 'library', label: 'Mis proteínas', icon: 'folder', href: '/proteins/' },
];

const pipelineItems = [
  { id: 'progress', label: 'Progreso', icon: 'workflow', href: `/proteins/${proteinId}/progress/` },
  { id: 'viewer', label: 'Visor', icon: 'eye', href: `/proteins/${proteinId}/viewer/` },
  { id: 'info', label: 'Información', icon: 'info', href: `/proteins/${proteinId}/info/` },
];

const items = mode === 'library' ? libraryItems : pipelineItems;
---
<nav class="sidebar" aria-label="Navegación principal">
  <div class="brand">
    <a href="/" aria-label="Ir al inicio">Mockup</a>
  </div>

  <div class="sidebar-items">
    {items.map((item) => (
      <a
        class:list={['sidebar-item', { active: active === item.id }]}
        href={item.href}
        aria-current={active === item.id ? 'page' : undefined}
      >
        <Icon name={item.icon} class="sidebar-icon" />
        <span>{item.label}</span>
      </a>
    ))}
  </div>
</nav>

<style>
  .sidebar {
    position: fixed;
    z-index: 60;
    left: 14px;
    top: 14px;
    bottom: 14px;
    width: var(--nav-w);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--panel);
    backdrop-filter: blur(12px);
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow: hidden;
  }
  .brand {
    min-height: 52px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    border-bottom: 1px solid var(--line);
    user-select: none;
  }
  .brand a {
    color: var(--ink);
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .brand a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .sidebar-items { display: flex; flex-direction: column; gap: 8px; min-height: 0; }
  .sidebar-item {
    position: relative;
    min-height: 62px;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: #fff;
    color: var(--ink);
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    padding: 0 14px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    transition: background 150ms ease, border-color 150ms ease, transform 150ms ease;
  }
  .sidebar-item:hover { border-color: rgba(17,19,24,.45); transform: translateX(1px); }
  .sidebar-item.active {
    background: rgba(81,171,117,.11);
    border-color: rgba(81,171,117,.46);
    color: var(--ink);
    box-shadow: 0 5px 18px rgba(17,19,24,.035);
  }
  .sidebar-item.active::before {
    content: '';
    position: absolute;
    left: -1px;
    top: -1px;
    bottom: -1px;
    width: 3px;
    background: var(--green);
  }
  .sidebar-icon { width: 21px; height: 21px; }
  .sidebar-item.active .sidebar-icon { color: var(--green-dark); }

  @media (max-width: 760px) {
    .sidebar { left: 10px; top: 10px; bottom: 10px; padding: 6px; }
    .sidebar-item { min-height: 56px; grid-template-columns: 22px minmax(0,1fr); gap: 9px; padding: 0 10px; font-size: 11px; }
    .sidebar-icon { width: 18px; height: 18px; }
    .brand { padding: 0 9px; min-height: 48px; }
    .brand a { font-size: 10px; }
  }
</style>
