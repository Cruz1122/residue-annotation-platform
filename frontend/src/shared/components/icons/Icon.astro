---
import PackIcon from './PackIcon.jsx';
import StageIcon from './StageIcon.jsx';

interface Props {
  name?: string;
  label?: string;
  class?: string;
  kind?: 'ui' | 'stage';
}

const {
  name = 'circle-dot',
  label,
  class: className = '',
  kind = 'ui',
} = Astro.props as Props;
---
{kind === 'stage'
  ? <StageIcon name={name} className={className} label={label} />
  : <PackIcon name={name} kind="ui" className={className} label={label} />}

<style>
  .icon-slot :global(.icon-asset) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
