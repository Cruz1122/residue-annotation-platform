---
import LucideIcon from './LucideIcon.jsx';

interface Props {
  name?: string;
  label?: string;
  class?: string;
}

const { name = 'circle-dot', label, class: className = '' } = Astro.props as Props;
---
<LucideIcon name={name} className={className} label={label} />

<style>
  .icon-slot { display: inline-grid; place-items: center; line-height: 0; }
  .icon-slot :global(.lucide-icon) { width: 100%; height: 100%; display: block; }
</style>
