---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '@shared/components/navigation/Sidebar.astro';

const {
  title,
  description,
  active = 'progress',
  sidebarMode = 'pipeline',
  proteinId = undefined,
  flush = false,
} = Astro.props;
---
<BaseLayout title={title} description={description} requiresAuth>
  <div class="app-page" transition:name="app-screen">
    <Sidebar active={active} mode={sidebarMode} proteinId={proteinId} />
    <main class:list={['page-with-sidebar', { flush }]}>
      <slot />
    </main>
  </div>
  <script>
    function keepRunQuery() {
      const run = new URLSearchParams(window.location.search).get('run');
      if (!run) return;
      for (const link of document.querySelectorAll('a.sidebar-item')) {
        const href = link.getAttribute('href');
        if (!href || !href.includes('/proteins/')) continue;
        const url = new URL(href, window.location.origin);
        url.searchParams.set('run', run);
        link.setAttribute('href', `${url.pathname}${url.search}`);
      }
    }
    keepRunQuery();
    if (!document.documentElement.dataset.rapKeepRun) {
      document.documentElement.dataset.rapKeepRun = '1';
      document.addEventListener('astro:page-load', keepRunQuery);
    }
  </script>
</BaseLayout>

<style>
  main.flush { padding-top: 0; padding-right: 0; padding-bottom: 0; }
</style>
