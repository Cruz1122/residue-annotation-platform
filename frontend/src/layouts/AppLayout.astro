---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '@shared/components/navigation/Sidebar.astro';

const {
  title,
  description,
  active = 'progress',
  sidebarMode = 'pipeline',
  proteinId = undefined,
  flush = false,
} = Astro.props;
---
<BaseLayout title={title} description={description} requiresAuth>
  <div class="app-page" transition:name="app-screen">
    <Sidebar active={active} mode={sidebarMode} proteinId={proteinId} />
    <main class:list={['page-with-sidebar', { flush }]}>
      <slot />
    </main>
  </div>
  <script>
    import { getRun } from '@shared/api/client';
    import { hasConfiguredVariants } from '@features/runs/run-capabilities.js';

    function keepRunQuery() {
      const run = new URLSearchParams(window.location.search).get('run');
      if (!run) return;
      for (const link of document.querySelectorAll('a.sidebar-item')) {
        const href = link.getAttribute('href');
        if (!href || !href.includes('/proteins/')) continue;
        const url = new URL(href, window.location.origin);
        url.searchParams.set('run', run);
        link.setAttribute('href', `${url.pathname}${url.search}`);
      }
    }

    async function updateVariantNavigation() {
      const link = document.querySelector('[data-variant-navigation]');
      if (!(link instanceof HTMLAnchorElement)) return;
      const runId = new URLSearchParams(window.location.search).get('run');
      if (!runId) {
        link.hidden = false;
        link.removeAttribute('aria-hidden');
        return;
      }
      try {
        const run = await getRun(runId);
        const currentRunId = new URLSearchParams(window.location.search).get('run');
        if (currentRunId !== runId) return;
        const hidden = !hasConfiguredVariants(run);
        link.hidden = hidden;
        link.toggleAttribute('aria-hidden', hidden);
      } catch {
        // Keep the navigation visible if the run cannot be checked; the page
        // itself will still explain when no variants were published.
        link.hidden = false;
        link.removeAttribute('aria-hidden');
      }
    }

    keepRunQuery();
    void updateVariantNavigation();
    if (!document.documentElement.dataset.rapKeepRun) {
      document.documentElement.dataset.rapKeepRun = '1';
      document.addEventListener('astro:page-load', () => {
        keepRunQuery();
        void updateVariantNavigation();
      });
    }
  </script>
</BaseLayout>

<style>
  main.flush { padding-top: 0; padding-right: 0; padding-bottom: 0; }
</style>
