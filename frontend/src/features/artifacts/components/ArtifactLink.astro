---
import Icon from '@shared/components/icons/Icon.astro';
const { stageId, filename } = Astro.props;
const href = `/mock-artifacts/${stageId}/${filename}`;
---
<a class="artifact-link" href={href} download={filename} title={`Descargar ${filename}`}>
  <Icon name="file-text" class="artifact-file-icon" />
  <span class="artifact-name">{filename}</span>
  <Icon name="download" class="artifact-download-icon" />
</a>
