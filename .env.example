# Browser/API development contract. Keep the public ports defined by the repo.
PUBLIC_API_BASE_URL=http://localhost:8742/api/v1
APP_NAME=residue-annotation-platform
APP_ENV=development
CORS_ORIGINS=http://localhost:4742

# docker compose up uses PostgreSQL. residue-dev is a local default only;
# override POSTGRES_PASSWORD outside the repository before any shared deploy.
# DATABASE_URL below is for a host process (uv/pytest), not the Compose network.
POSTGRES_PASSWORD=residue-dev
DATABASE_URL=sqlite:///./data/residue_annotation.db
DATABASE_AUTO_CREATE=true
ARTIFACT_ROOT=./data/artifacts
MAX_UPLOAD_BYTES=5242880
DEV_USER_ID=local-user
DEV_PROJECT_ID=local-project

# Bearer auth defaults are development-only. Set a long random secret outside
# the repository before using production or a shared environment.
AUTH_JWT_SECRET=development-only-change-this-secret-before-production
AUTH_TRUSTED_HEADERS_ENABLED=false
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Aggregate per-IP bucket across accounts (bounds credential stuffing); raise it
# for deployments behind a NAT/proxy serving many users.
AUTH_RATE_LIMIT_IP=50

# Transactional account email. Keep disabled until RESEND_API_KEY and a sender
# are configured. Production rejects the resend.dev test sender: use an address
# on a verified Resend domain instead.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM="Residue Annotation <onboarding@resend.dev>"
FRONTEND_BASE_URL=http://localhost:4742

# Worker lease/retry bounds and the default annotation page cap (limit/offset
# can still page explicitly up to 50000 rows per request).
RUN_WORKER_LEASE_SECONDS=900
RUN_WORKER_MAX_ATTEMPTS=3
ANNOTATIONS_DEFAULT_LIMIT=20000

# Optional: enables the 4 PostgreSQL concurrency tests in
# backend/tests/test_postgres_concurrency.py. Point it at a disposable database.
# POSTGRES_TEST_DATABASE_URL=postgresql+psycopg://rap:rap@localhost:5432/rap_test

# Select exactly one execution profile:
# - vpn: workstation mode; starts the VPN and submits through SSH/SCP.
# - mn5: direct MareNostrum mode; run this Compose stack on MN5 itself.
COMPOSE_PROFILES=vpn

# The selected Compose profile starts the worker and submits validated runs
# automatically. HPC_EXECUTION_MODE is retained for host-process compatibility;
# Compose sets the worker mode from COMPOSE_PROFILES. Keep passwords out of
# this file: use protected files (mode
# 0600) or a protected openfortivpn config. The file paths below are host paths
# used only as read-only mounts.
HPC_EXECUTION_MODE=ssh
MN5_INSPECTION_MODE=disabled
MN5_INSPECTION_ENABLED=false

# Automatic VPN and SSH references. Do not put passwords in this file.
# HPC_VPN_CONFIG_FILE may point to a protected openfortivpn config that already
# contains the gateway credentials. Otherwise set HPC_VPN_PASSWORD_FILE to a
# protected one-line password file.
HPC_VPN_HOST=gw.bsc.es
HPC_VPN_PORT=443
HPC_VPN_USERNAME=
HPC_VPN_CONFIG_FILE=/etc/openfortivpn/config
HPC_VPN_PASSWORD_FILE=/path/to/hpc_vpn_password
HPC_VPN_RECONNECT_SECONDS=60
HPC_SSH_PORT=22
HPC_SSH_HOST=glogin4.bsc.es
HPC_SSH_USERNAME=
HPC_SSH_PASSWORD_FILE=/path/to/hpc_ssh_password
HPC_KNOWN_HOSTS_FILE=/path/to/known_hosts
HPC_REMOTE_ROOT=/gpfs/projects/bsc08/bsc001997/vcfs_1000geno/hilo_integrado_anotacion
HPC_INPUT_TRANSFER_ENABLED=true
HPC_INPUT_REMOTE_SUBDIR=uploads
HPC_SLURM_ACCOUNT=
HPC_SLURM_PARTITION=
HPC_SLURM_QOS=
HPC_SLURM_TIME=00:30:00
HPC_PIPELINE_PYTHON=python
HPC_PIPELINE_MAIN=main.py
HPC_PIPELINE_MAX_PARALLEL=1
HPC_PIPELINE_CPU_BUDGET=32
HPC_PIPELINE_GPU_BUDGET=1
HPC_MAX_RESULT_BYTES=268435456
# Remote stages polled/submitted per worker tick. Keep at 1 until the cluster
# capacity and pipeline concurrency have been validated.
HPC_MAX_INFLIGHT_STAGES=1

# Native MN5 profile only. The image is provisioned on MN5 with the project,
# Python dependencies, Slurm client/auth tooling and the matching UID/GID.
# Do not set these for the local vpn profile.
# HPC_NATIVE_WORKER_IMAGE=residue-annotation-platform-worker-native
# HPC_NATIVE_UID=999
# HPC_NATIVE_GID=999
# HPC_NATIVE_ROOT=/gpfs/projects/bsc08/bsc001997/vcfs_1000geno/hilo_integrado_anotacion
# HPC_NATIVE_SLURM_CONFIG_DIR=/etc/slurm
# HPC_NATIVE_MUNGE_DIR=/run/munge
# HPC_NATIVE_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MN5_ROOT=/gpfs/projects/bsc08/bsc001997/vcfs_1000geno/hilo_integrado_anotacion
MN5_MAX_ENTRIES=100
MN5_MAX_PREVIEW_BYTES=64000
