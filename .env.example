# Local mock profile.
# The current scaffold does not load these HPC variables yet. Keep the example
# offline and non-secret so it cannot accidentally reach BSC/MN5.
HPC_EXECUTION_MODE=mock
MN5_INSPECTION_MODE=mock
MN5_INSPECTION_ENABLED=false

# Mock VPN (host-managed in a real profile; never start it from FastAPI)
HPC_VPN_HOST=mock-vpn.invalid
HPC_VPN_PORT=443
HPC_VPN_USERNAME=mock-vpn-user
HPC_VPN_REQUIRED=false

# Mock SSH/SFTP
HPC_SSH_HOST=mock-ssh.invalid
HPC_SSH_PORT=22
HPC_SSH_USERNAME=mock-user
HPC_SSH_AUTH_METHOD=mock
HPC_SSH_PASSWORD_FILE=/run/secrets/mock_ssh_password
HPC_VPN_PASSWORD_FILE=/run/secrets/mock_vpn_password

# Job supervision
HPC_POLL_INTERVAL_SECONDS=30
